# Vector store: "pgvector" (Postgres) or "sqlite" (file/in-memory fallback, no server needed)
COPILOT_STORE=pgvector
COPILOT_DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
COPILOT_SQLITE_PATH=.data/copilot.sqlite

# Embeddings: "sentence-transformers" (local CPU model) or "hash" (deterministic, tests/offline)
COPILOT_EMBEDDER=sentence-transformers
COPILOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Retrieval
COPILOT_RETRIEVAL_MODE=hybrid   # bm25 | vector | hybrid
COPILOT_TOP_K=5
COPILOT_RERANK=true
COPILOT_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Abstention: the calibrated rule file wins when it exists (python -m copilot.evals calibrate, docs/EVALS.md).
# The dense-only threshold is the fallback when the file is missing or COPILOT_ABSTAIN_RULE_PATH=none.
# COPILOT_ABSTAIN_RULE_PATH=evals/abstention_rule.json
COPILOT_ABSTAIN_THRESHOLD=0.83

# Cost reporting only (USD per million tokens of your LLM); unset = reported as "unknown"
COPILOT_LLM_PRICE_INPUT_PER_MTOK=
COPILOT_LLM_PRICE_OUTPUT_PER_MTOK=

# LLM: "none" (extractive, offline), "anthropic" or "openai"
COPILOT_LLM_PROVIDER=none
COPILOT_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Guardrails (PII masking, prompt-injection handling, output citation/number checks); see docs/SECURITY.md
COPILOT_GUARDRAILS=true

# Observability: JSON logs (one line per request, with request_id) and OpenTelemetry spans
COPILOT_LOG_LEVEL=INFO
COPILOT_LOG_JSON=true
COPILOT_OTEL_EXPORTER=none   # none | console | otlp (needs .[otel]; uses OTEL_EXPORTER_OTLP_ENDPOINT)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
